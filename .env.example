# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored - never commit real secrets.

DB_NAME=quoteguard
DB_USERNAME=postgres
DB_PASSWORD=change-me-to-a-real-password

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-generate-a-real-256-bit-secret

JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

SPRING_PROFILES_ACTIVE=prod
APP_VERIFICATION_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
